@model IEnumerable<CartItem>

<div class="container py-5">
    <h1 class="display-6 fw-bold mb-4">Sepetim</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            <h4 class="alert-heading">Sepetiniz boş!</h4>
            <p>Listenizde henüz ürün bulunmamaktadır.</p>
            <hr>
            <a asp-controller="Product" asp-action="GetProduct" class="btn btn-primary">Alışverişe Başla</a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Sepet Tablosu (Sol taraf) -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Ürün</th>
                                    <th scope="col" class="text-center">Fiyat</th>
                                    <th scope="col" class="text-center">Adet</th>
                                    <th scope="col" class="text-end pe-4">Toplam</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <img src="@item.Product.ResimUrl" alt="@item.Product.Ad"
                                                     class="img-thumbnail me-3"
                                                     style="width: 80px; height: 80px; object-fit: cover;">
                                                <div>
                                                    <h6 class="mb-0 fw-bold">@item.Product.Ad</h6>
                                                    <small class="text-muted">Kategori: @item.Product.Kategori</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-semibold">@item.Product.Fiyat.ToString("N2") ₺</td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center align-items-center gap-2">
                                                <form asp-controller="Cart" asp-action="Decrease" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">-</button>
                                                </form>

                                                <span
                                                class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">@item.Quantity</span>

                                                <form asp-controller="Cart" asp-action="Increase" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">+</button>
                                                </form>
                                            </div>

                                        </td>
                                        <td class="text-end pe-4 fw-bold text-success">
                                            @((item.Product.Fiyat * item.Quantity).ToString("N2")) ₺
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Sipariş Özeti (Sağ Taraf) -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body p-4">
                        <h4 class="card-title fw-bold mb-4">Sipariş Özeti</h4>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Ara Toplam</span>
                            <span class="fw-semibold">@Model.Sum(x => x.Product.Fiyat * x.Quantity).ToString("N2") ₺</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Kargo</span>
                            <span class="text-success fw-semibold">Bedava</span>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between mb-4">
                            <span class="fs-5 fw-bold">Genel Toplam</span>
                            <span class="fs-4 fw-bold text-danger">@Model.Sum(x => x.Product.Fiyat *
                                                                                                                                                                                                                            x.Quantity).ToString("N2") ₺</span>
                            </div>

                            <button class="btn btn-success btn-lg w-100 fw-bold shadow-sm">
                                Alışverişi Tamamla
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>