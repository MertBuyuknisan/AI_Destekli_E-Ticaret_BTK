@{
    ViewData["Title"] = "Yapay Zeka Asistanı";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-robot"></i> E-Ticaret Asistanı (Gemini AI)</h5>
            </div>

            <!-- Sohbet Geçmişi Alanı -->
            <div class="card-body" id="chat-box" style="height: 400px; overflow-y: auto; background-color: #f8f9fa;">
                <div class="text-center text-muted mt-2">
                    <small>Yapay zeka asistanına ürünlerimiz veya siparişlerin hakkında soru sorabilirsin.</small>
                </div>
            </div>

            <!-- Mesaj Yazma Alanı -->
            <div class="card-footer">
                <div class="input-group">
                    <input type="text" id="userInput" class="form-control" placeholder="Bir mesaj yazın..."
                           onkeypress="handleKeyPress(event)" />
                    <button class="btn btn-primary" id="sendBtn" onclick="sendMessage()">Gönder</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
            const chatBox = document.getElementById("chat-box");
            const userInput = document.getElementById("userInput");
            const sendBtn = document.getElementById("sendBtn");

            // Enter tuşuna basılınca göndermesi için
            function handleKeyPress(e) {
                if (e.key === 'Enter') {
                    sendMessage();
                }
            }

            async function sendMessage() {
                const message = userInput.value.trim();
                if (!message) return;

                // 1. Kullanıcının mesajını ekrana ekle
                appendMessage("Sen", message, "text-end", "bg-white border text-dark");
                userInput.value = ""; // Kutuyu temizle

                // Bekleme efekti (Kullanıcı AI'nin düşündüğünü görsün)
                sendBtn.disabled = true;
                sendBtn.innerText = "Yazıyor...";

                try {
                    // 2. Controller'a mesajı gönder
                    const response = await fetch('/Chat/SendMessage', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ message: message }) // ChatRequest sınıfına uygun formatta
                    });

                    if (response.ok) {
                        const data = await response.json();
                        // 3. Gemini'den gelen cevabı ekrana ekle
                        appendMessage("Asistan", data.response, "text-start", "bg-primary text-white");
                    } else {
                        appendMessage("Sistem", "Bağlantı hatası oluştu.", "text-center", "bg-danger text-white");
                    }
                } catch (error) {
                    appendMessage("Sistem", "Beklenmeyen bir hata oluştu.", "text-center", "bg-danger text-white");
                } finally {
                    // Butonu eski haline getir
                    sendBtn.disabled = false;
                    sendBtn.innerText = "Gönder";
                }
            }

            // Ekrana sohbet baloncuğu ekleyen yardımcı fonksiyon
            function appendMessage(sender, text, alignment, colorClass) {
                const msgDiv = document.createElement("div");
                msgDiv.className = `mb-3 ${alignment}`;

                const bubble = document.createElement("span");
                bubble.className = `d-inline-block p-2 rounded ${colorClass}`;
                bubble.style.maxWidth = "75%";

                // Gemini markdown bold yapabilir (**metin**). En basitiyle ekrana basalım.
                bubble.innerHTML = `<strong>${sender}:</strong> <br/> ${text}`;

                msgDiv.appendChild(bubble);
                chatBox.appendChild(msgDiv);

                // Otomatik en alta kaydır
                chatBox.scrollTop = chatBox.scrollHeight;
            }
    </script>
}